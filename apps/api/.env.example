# Copy to .env and adjust. All values are optional in development.
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173
# Session lifetime in hours.
SESSION_TTL_HOURS=168

# OAuth providers — leave empty until configured; their login buttons stay disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Storage. By default accounts, sessions and projects are saved in a SQLite database at
# apps/api/.data/canvas.db (tests use memory). DATA_DIR moves that folder; relative paths
# resolve from the directory the API is started in.
DATA_DIR=

# Optional: Supabase Postgres instead of SQLite (see supabase/README.md). Setting both values
# switches storage to Supabase. Leave them empty to keep everything local. The service-role key
# is server-only. Never put it in the web app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI build engine. Picked in this order unless AI_ENGINE forces one (gemini | nim | claude | local):
# Gemini when GEMINI_API_KEY is set, NVIDIA NIM when NVIDIA_API_KEY is set, Claude when
# ANTHROPIC_API_KEY is set, else the offline "Canvas Local" engine. The AI engines use the system
# prompt in prompts/website-builder.md and the design references in prompts/design/.

# Google AI Studio key (https://aistudio.google.com/apikey).
GEMINI_API_KEY=
# Defaults: gemini-3.8-flash, falling back to gemini-3.6-flash when it is overloaded or out of
# quota. Pro models need a paid tier.
GEMINI_MODEL=
GEMINI_FALLBACK_MODELS=
NVIDIA_API_KEY=
# Any NIM chat model; vision models also get the reference screenshots.
# e.g. minimaxai/minimax-m3.1-flash (default) or stepfun-ai/step-5-preview
NVIDIA_MODEL=
NVIDIA_BASE_URL=
ANTHROPIC_API_KEY=
# Optional overrides — defaults: claude-opus-5-5, medium effort.
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=
AI_ENGINE=
