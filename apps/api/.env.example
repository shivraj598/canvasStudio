# Copy to .env and adjust. All values are optional in development.
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173
# Session lifetime in hours.
SESSION_TTL_HOURS=168

# OAuth providers — leave empty until configured; their login buttons stay disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI build engine. Picked in this order unless AI_ENGINE forces one (nim | claude | local):
# NVIDIA NIM when NVIDIA_API_KEY is set, Claude when ANTHROPIC_API_KEY is set, else the offline
# "Canvas Local" engine. Both AI engines use the system prompt in prompts/website-builder.md and
# the design references in prompts/design/.
NVIDIA_API_KEY=
# Any NIM chat model; vision models also get the reference screenshots.
# e.g. minimaxai/minimax-m3.1-flash (default) or stepfun-ai/step-5-preview
NVIDIA_MODEL=
NVIDIA_BASE_URL=
ANTHROPIC_API_KEY=
# Optional overrides — defaults: claude-opus-5-5, medium effort.
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=
AI_ENGINE=
