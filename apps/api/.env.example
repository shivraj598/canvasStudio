# Copy to .env and adjust. All values are optional in development.
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173
# Session lifetime in hours.
SESSION_TTL_HOURS=168

# OAuth providers — leave empty until configured; their login buttons stay disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
